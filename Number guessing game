import random

# Outer loop: Keeps the entire game running until the player wants to quit
while True:
    computer_number = random.randint(1, 10)
    lives = 3
    print("\n--- New Game! Guess a number between 1 and 10 ---")

    # Inner loop: Controls the current round's lives
    while lives > 0:
        user_input = input("Enter a number: ")
        user_number = int(user_input)  # Converts the text to a number

        if user_number == computer_number:
            print("You win!")
            break  # Stops the "lives" loop because you won
        else:
            print("Try again")
            lives = lives - 1  # Standard subtraction syntax

    # After the inner loop ends, check if they lost
    if lives == 0:
        print("Computer wins! The number was " + str(computer_number))

    # Ask to play again
    decision = input("Would you like to play again? (yes or no): ")
    if decision.lower() != "yes":
        print("Thanks for playing! Goodbye.")
        break  # Stops the outer loop and ends the whole program
